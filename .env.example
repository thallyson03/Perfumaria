# Copie para .env na raiz e para apps/api/.env (dev local)

DATABASE_URL="postgresql://revendedor:revendedor@localhost:5434/revendedor?schema=public"
# A API em produção usa o role sem BYPASSRLS (veja .env.production.example)
DATABASE_URL_APP="postgresql://revendedor_app:revendedor_app@localhost:5434/revendedor?schema=public"
# Superuser só para REFRESH da materialized view / migrations
DATABASE_URL_ADMIN="postgresql://revendedor:revendedor@localhost:5434/revendedor?schema=public"
REDIS_URL="redis://localhost:6380"
CART_RESERVE_TTL_SECONDS=900
ORDER_WHATSAPP_TTL_SECONDS=3600
ORDER_PAYMENT_TTL_SECONDS=1800

# Webhook n8n/Evolution para alertas e novos pedidos WhatsApp
N8N_ALERTS_WEBHOOK_URL=

JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"

API_PORT=3001
API_HOST=0.0.0.0

# Domínio raiz das vitrines (subdomínios: loja.localhost em dev)
ROOT_DOMAIN="localhost"
NEXT_PUBLIC_ROOT_DOMAIN="localhost"

# Apps Next.js
NEXT_PUBLIC_API_URL="http://localhost:3001"
