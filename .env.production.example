# Produção / Coolify — copie para variáveis do recurso Compose
# Nunca commite senhas reais.

# Domínio raiz das vitrines (sem https://)
# Ex.: lojas.seudominio.com → https://minhaloja.lojas.seudominio.com
ROOT_DOMAIN=lojas.seudominio.com

# URLs públicas (HTTPS do Coolify)
NEXT_PUBLIC_API_URL=https://api.seudominio.com
# Painel: https://admin.seudominio.com
# Vitrine: https://*.lojas.seudominio.com  (wildcard DNS + domínio no Coolify)

# Segredos (gere com: openssl rand -base64 48)
# Senhas podem ter # @ etc. — a API faz URL-encode automaticamente
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

POSTGRES_USER=revendedor
POSTGRES_DB=revendedor
JWT_EXPIRES_IN=7d

# Opcional
N8N_ALERTS_WEBHOOK_URL=
CART_RESERVE_TTL_SECONDS=900
ORDER_WHATSAPP_TTL_SECONDS=3600
ORDER_PAYMENT_TTL_SECONDS=1800

# Portas publicadas no host (Coolify pode gerenciar; deixe padrão se possível)
# API_PUBLISH_PORT=3001
# ADMIN_PUBLISH_PORT=3000
# STOREFRONT_PUBLISH_PORT=3002
